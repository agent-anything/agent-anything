{
  "name": "@agent-anything/helarc",
  "version": "0.0.0",
  "description": "Delivery-independent Helarc Code Agent product semantics and composition.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./dist/index.js" },
    "./agent": { "types": "./src/agent/index.ts", "import": "./dist/agent/index.js" },
    "./task": { "types": "./src/task/index.ts", "import": "./dist/task/index.js" },
    "./configuration": { "types": "./src/configuration/index.ts", "import": "./dist/configuration/index.js" },
    "./work-context": { "types": "./src/work-context/index.ts", "import": "./dist/work-context/index.js" },
    "./thread": { "types": "./src/thread/index.ts", "import": "./dist/thread/index.js" },
    "./run": { "types": "./src/run/index.ts", "import": "./dist/run/index.js" },
    "./prompt": { "types": "./src/prompt/index.ts", "import": "./dist/prompt/index.js" },
    "./controller": { "types": "./src/controller/index.ts", "import": "./dist/controller/index.js" },
    "./tools": { "types": "./src/tools/index.ts", "import": "./dist/tools/index.js" },
    "./result": { "types": "./src/result/index.ts", "import": "./dist/result/index.js" },
    "./artifacts": { "types": "./src/artifacts/index.ts", "import": "./dist/artifacts/index.js" },
    "./composition": { "types": "./src/composition/index.ts", "import": "./dist/composition/index.js" },
    "./observability": { "types": "./src/observability/index.ts", "import": "./dist/observability/index.js" },
    "./validation": { "types": "./src/validation/index.ts", "import": "./dist/validation/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "agentAnything": {
    "architecture": {
      "kind": "product",
      "productId": "helarc",
      "component": "core"
    }
  },
  "license": "Apache-2.0",
  "private": true,
  "dependencies": {
    "@agent-anything/action-execution": "workspace:*",
    "@agent-anything/agent-core": "workspace:*",
    "@agent-anything/agent-runtime": "workspace:*",
    "@agent-anything/canonical-action": "workspace:*",
    "@agent-anything/context": "workspace:*",
    "@agent-anything/helarc-code-agent": "workspace:*",
    "@agent-anything/host": "workspace:*",
    "@agent-anything/interaction": "workspace:*",
    "@agent-anything/model-interaction": "workspace:*",
    "@agent-anything/observability": "workspace:*",
    "@agent-anything/operation-catalog": "workspace:*",
    "@agent-anything/operation-composition": "workspace:*",
    "@agent-anything/tools": "workspace:*",
    "@agent-anything/validation": "workspace:*",
    "@agent-anything/workspace": "workspace:*"
  },
  "devDependencies": { "@types/node": "^25.9.1" }
}

{
    "name":  "@agent-anything/helarc",
    "version":  "0.0.0",
    "description":  "Helarc product composition for the AgentAnything developer workbench.",
    "type":  "module",
    "main":  "./dist/index.js",
    "types":  "./src/index.ts",
    "exports":  {
                    ".":  {
                              "types":  "./src/index.ts",
                              "import":  "./dist/index.js"
                          },
                    "./configuration":  {
                                              "types":  "./src/configuration/index.ts",
                                              "import":  "./dist/configuration/index.js"
                                          },
                    "./work-context":  {
                                           "types":  "./src/work-context/index.ts",
                                           "import":  "./dist/work-context/index.js"
                                       },
                    "./run":  {
                                  "types":  "./src/run/index.ts",
                                  "import":  "./dist/run/index.js"
                              },
                    "./composition":  {
                                          "types":  "./src/composition/index.ts",
                                          "import":  "./dist/composition/index.js"
                                      }
                },
    "files":  [
                  "dist"
              ],
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "test":  "vitest run --passWithNoTests"
                },
    "agentAnything":  {
                           "architecture":  {
                                                "kind":  "product",
                                                "productId":  "helarc",
                                                "component":  "product"
                                            }
                       },
    "license":  "Apache-2.0",
    "private":  true,
    "dependencies":  {
                         "@agent-anything/action-execution":  "workspace:*",
                         "@agent-anything/canonical-action":  "workspace:*",
                         "@agent-anything/observability":  "workspace:*",
                         "@agent-anything/agent-runtime":  "workspace:*",
                         "@agent-anything/helarc-code-agent":  "workspace:*",
                         "@agent-anything/host":  "workspace:*",
                         "@agent-anything/model-interaction":  "workspace:*",
                         "@agent-anything/agent-core":  "workspace:*",
                         "@agent-anything/tools":  "workspace:*",
                         "@agent-anything/workspace":  "workspace:*"
                     },
    "devDependencies":  {
                            "@types/node":  "^25.9.1"
                        }
}

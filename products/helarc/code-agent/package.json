{
  "name": "@agent-anything/helarc-code-agent",
  "version": "0.0.0",
  "description": "Code Agent workspace, filesystem, command, and patch capabilities for the Helarc product.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./workspace": {
      "types": "./src/workspace/index.ts",
      "import": "./dist/workspace/index.js"
    },
    "./filesystem": {
      "types": "./src/filesystem/index.ts",
      "import": "./dist/filesystem/index.js"
    },
    "./command": {
      "types": "./src/process/index.ts",
      "import": "./dist/process/index.js"
    },
    "./patch": {
      "types": "./src/patch/index.ts",
      "import": "./dist/patch/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "license": "Apache-2.0",
  "private": true,
  "dependencies": {
    "@agent-anything/action-execution": "workspace:*",
    "@agent-anything/governance": "workspace:*",
    "@agent-anything/foundation": "workspace:*",
    "@agent-anything/tools": "workspace:*"
  },
  "devDependencies": {
    "@agent-anything/context": "workspace:*",
    "@agent-anything/runtime": "workspace:*",
    "@agent-anything/permission": "workspace:*",
    "@agent-anything/testing": "workspace:*",
    "@types/node": "^25.9.1"
  }
}

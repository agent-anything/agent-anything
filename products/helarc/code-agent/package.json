{
  "name": "@agent-anything/helarc-code-agent",
  "version": "0.0.0",
  "description": "Bounded Code Workspace source and file-operation semantics retained until Phase 28.",
  "type": "module",
  "exports": {
    "./workspace": { "types": "./src/workspace/index.ts", "import": "./dist/workspace/index.js" },
    "./source": { "types": "./src/source/index.ts", "import": "./dist/source/index.js" },
    "./verification": { "types": "./src/verification/index.ts", "import": "./dist/verification/index.js" },
    "./file-operation": { "types": "./src/file-operation/index.ts", "import": "./dist/file-operation/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "agentAnything": {
    "architecture": {
      "kind": "product",
      "productId": "helarc",
      "component": "code-workspace"
    }
  },
  "license": "Apache-2.0",
  "private": true,
  "dependencies": {
    "@agent-anything/agent-core": "workspace:*",
    "@agent-anything/canonical-action": "workspace:*",
    "@agent-anything/operation-catalog": "workspace:*",
    "@agent-anything/tools": "workspace:*",
    "@agent-anything/verification": "workspace:*",
    "@agent-anything/workspace": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1"
  }
}

{
  "name": "@agent-anything/action-execution",
  "version": "0.0.0",
  "description": "Trusted external Action preparation, assessment, revalidation, and sandbox execution for AgentAnything.",
  "type": "module",
  "exports": {
    "./registration": {
      "types": "./src/registration/index.ts",
      "import": "./dist/registration/index.js"
    },
    "./enforcement": {
      "types": "./src/enforcement/index.ts",
      "import": "./dist/enforcement/index.js"
    },
    "./sandbox": {
      "types": "./src/sandbox/index.ts",
      "import": "./dist/sandbox/index.js"
    },
    "./execution": {
      "types": "./src/execution/index.ts",
      "import": "./dist/execution/index.js"
    },
    "./coordination": {
      "types": "./src/coordination/index.ts",
      "import": "./dist/coordination/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "agentAnything": {
    "architecture": {
      "kind": "harness",
      "component": "safety.action-execution"
    }
  },
  "dependencies": {
    "@agent-anything/canonical-action": "workspace:*",
    "@agent-anything/governance": "workspace:*",
    "@agent-anything/permission": "workspace:*",
    "@agent-anything/agent-core": "workspace:*",
    "@agent-anything/operation-catalog": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1"
  },
  "license": "Apache-2.0",
  "private": true
}

{
  "name": "@agent-anything/foundation",
  "version": "0.0.0",
  "description": "Domain-neutral Foundation contracts for Agent Harness.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./action": {
      "types": "./src/action/index.ts",
      "import": "./dist/action/index.js"
    },
    "./agent": {
      "types": "./src/agent/index.ts",
      "import": "./dist/agent/index.js"
    },
    "./artifact": {
      "types": "./src/artifact/index.ts",
      "import": "./dist/artifact/index.js"
    },
    "./interaction": {
      "types": "./src/interaction/index.ts",
      "import": "./dist/interaction/index.js"
    },
    "./invocation": {
      "types": "./src/invocation/index.ts",
      "import": "./dist/invocation/index.js"
    },
    "./primitives": {
      "types": "./src/primitives/index.ts",
      "import": "./dist/primitives/index.js"
    },
    "./run": {
      "types": "./src/run/index.ts",
      "import": "./dist/run/index.js"
    },
    "./task": {
      "types": "./src/task/index.ts",
      "import": "./dist/task/index.js"
    },
    "./workspace": {
      "types": "./src/workspace/index.ts",
      "import": "./dist/workspace/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "agentAnything": {
    "architecture": {
      "kind": "harness",
      "component": "foundation"
    }
  },
  "license": "Apache-2.0",
  "private": true
}

{
  "name": "@agent-anything/context",
  "version": "0.0.0",
  "description": "Generic Run Context state, explicit projection, Evidence, and owner-defined Evidence persistence for Agent Harness.",
  "type": "module",
  "exports": {
    "./custody": {"types":"./src/custody/index.ts","import":"./dist/custody/index.js"},
    "./representation": {"types":"./src/representation/index.ts","import":"./dist/representation/index.js"},
    "./selection": {"types":"./src/selection/index.ts","import":"./dist/selection/index.js"},
    "./preparation": {
      "types": "./src/preparation/index.ts",
      "import": "./dist/preparation/index.js"
    },
    "./material": {
      "types": "./src/material/index.ts",
      "import": "./dist/material/index.js"
    },
    "./contract": {
      "types": "./src/contract/index.ts",
      "import": "./dist/contract/index.js"
    },
    "./contribution": {
      "types": "./src/contribution/index.ts",
      "import": "./dist/contribution/index.js"
    },
    "./active-context": {
      "types": "./src/active-context/index.ts",
      "import": "./dist/active-context/index.js"
    },
    "./projection": {
      "types": "./src/projection/index.ts",
      "import": "./dist/projection/index.js"
    },
    "./evidence": {
      "types": "./src/evidence/index.ts",
      "import": "./dist/evidence/index.js"
    },
    "./persistence": {
      "types": "./src/persistence/index.ts",
      "import": "./dist/persistence/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "agentAnything": {
    "architecture": {
      "kind": "harness",
      "component": "context"
    }
  },
  "dependencies": {
    "@agent-anything/agent-core": "workspace:*"
  },
  "license": "Apache-2.0",
  "private": true
}

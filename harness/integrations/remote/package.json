{
  "name": "@agent-anything/remote-integrations",
  "version": "0.0.0",
  "description": "Protocol-neutral hosted Operation and canonical Action adaptation for Agent Harness.",
  "type": "module",
  "exports": {
    "./operation": {
      "types": "./src/operation/index.ts",
      "import": "./dist/operation/index.js"
    },
    "./transport": {
      "types": "./src/transport/index.ts",
      "import": "./dist/transport/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "agentAnything": {
    "architecture": {
      "kind": "harness",
      "component": "integrations.remote"
    }
  },
  "dependencies": {
    "@agent-anything/action-execution": "workspace:*",
    "@agent-anything/canonical-action": "workspace:*",
    "@agent-anything/operation-catalog": "workspace:*",
    "@agent-anything/tools": "workspace:*"
  },
  "devDependencies": {
    "@agent-anything/context": "workspace:*",
    "@agent-anything/governance": "workspace:*",
    "@agent-anything/permission": "workspace:*",
    "@agent-anything/agent-runtime": "workspace:*",
    "@agent-anything/test-support": "workspace:*"
  },
  "license": "Apache-2.0",
  "private": true
}

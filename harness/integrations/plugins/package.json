{
  "name": "@agent-anything/plugins",
  "version": "0.0.0",
  "description": "Plugin declaration, trust-admission, and contribution activation contracts for Agent Harness.",
  "type": "module",
  "exports": {
    "./manifest": {
      "types": "./src/manifest/index.ts",
      "import": "./dist/manifest/index.js"
    },
    "./admission": {
      "types": "./src/admission/index.ts",
      "import": "./dist/admission/index.js"
    },
    "./lifecycle": {
      "types": "./src/lifecycle/index.ts",
      "import": "./dist/lifecycle/index.js"
    },
    "./activation": {
      "types": "./src/activation/index.ts",
      "import": "./dist/activation/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "agentAnything": {
    "architecture": {
      "kind": "harness",
      "component": "integrations.plugins"
    }
  },
  "dependencies": {
    "@agent-anything/agent-core": "workspace:*",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@types/semver": "7.7.1"
  },
  "license": "Apache-2.0",
  "private": true
}

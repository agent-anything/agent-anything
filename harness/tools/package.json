{
  "name": "@agent-anything/tools",
  "version": "0.0.0",
  "description": "Declarative Tool registration, selection, catalog, and result contracts for Agent Harness.",
  "type": "module",
  "exports": {
    "./catalog": {
      "types": "./src/catalog/index.ts",
      "import": "./dist/catalog/index.js"
    },
    "./identity": {
      "types": "./src/identity/index.ts",
      "import": "./dist/identity/index.js"
    },
    "./registration": {
      "types": "./src/registration/index.ts",
      "import": "./dist/registration/index.js"
    },
    "./selection": {
      "types": "./src/selection/index.ts",
      "import": "./dist/selection/index.js"
    },
    "./invocation": {
      "types": "./src/invocation/index.ts",
      "import": "./dist/invocation/index.js"
    },
    "./validation": {
      "types": "./src/validation/index.ts",
      "import": "./dist/validation/index.js"
    },
    "./result": {
      "types": "./src/result/index.ts",
      "import": "./dist/result/index.js"
    },
    "./activation": {
      "types": "./src/activation/index.ts",
      "import": "./dist/activation/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "agentAnything": {
    "architecture": {
      "kind": "harness",
      "component": "tools"
    }
  },
  "license": "Apache-2.0",
  "private": true,
  "dependencies": {
    "@agent-anything/agent-core": "workspace:*",
    "@agent-anything/operation-catalog": "workspace:*",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1"
  }
}

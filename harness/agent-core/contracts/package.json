{
  "name": "@agent-anything/agent-core",
  "version": "0.0.0",
  "description": "Dependency-safe Agent Core contracts for Agent Harness.",
  "type": "module",
  "exports": {
    "./agent": {
      "types": "./src/agent/index.ts",
      "import": "./dist/agent/index.js"
    },
    "./input": {
      "types": "./src/input/index.ts",
      "import": "./dist/input/index.js"
    },
    "./run": {
      "types": "./src/run/index.ts",
      "import": "./dist/run/index.js"
    },
    "./run-action": {
      "types": "./src/run-action/index.ts",
      "import": "./dist/run-action/index.js"
    },
    "./run-item": {
      "types": "./src/run-item/index.ts",
      "import": "./dist/run-item/index.js"
    },
    "./control": {
      "types": "./src/control/index.ts",
      "import": "./dist/control/index.js"
    },
    "./task": {
      "types": "./src/task/index.ts",
      "import": "./dist/task/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "agentAnything": {
    "architecture": {
      "kind": "harness",
      "component": "agent-core",
      "role": "contracts"
    }
  },
  "license": "Apache-2.0",
  "private": true,
  "dependencies": {
    "@agent-anything/workspace": "workspace:*"
  }
}

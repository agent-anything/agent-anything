{
  "name": "@agent-anything/agent-core",
  "version": "0.0.0",
  "description": "Transitional RuntimeEvent contracts awaiting the Harness Observability package.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./events": {
      "types": "./src/events/index.ts",
      "import": "./dist/events/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agent-anything/foundation": "workspace:*"
  },
  "devDependencies": {
    "@agent-anything/testing": "workspace:*"
  },
  "license": "Apache-2.0",
  "private": true
}

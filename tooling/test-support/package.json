{
  "name": "@agent-anything/test-support",
  "version": "0.0.0",
  "description": "Reusable development-only fakes and fixtures for Agent Harness packages.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "agentAnything": {
    "architecture": {
      "kind": "tooling",
      "component": "test-support"
    }
  },
  "dependencies": {
    "@agent-anything/context": "workspace:*",
    "@agent-anything/observability": "workspace:*",
    "@agent-anything/permission": "workspace:*",
    "@agent-anything/model-interaction": "workspace:*",
    "@agent-anything/foundation": "workspace:*"
  },
  "license": "Apache-2.0",
  "private": true
}

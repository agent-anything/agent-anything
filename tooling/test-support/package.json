{
  "name": "@agent-anything/test-support",
  "version": "0.0.0",
  "description": "Reusable development-only fakes and fixtures for Agent Harness packages.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./evaluation-targets/helarc": {
      "types": "./src/evaluation-targets/helarc/index.ts",
      "import": "./dist/evaluation-targets/helarc/index.js"
    },
    "./context-continuity-evaluation": {
      "types": "./src/context-continuity-evaluation/index.ts",
      "import": "./dist/context-continuity-evaluation/index.js"
    },
    "./run-progress-evaluation": {
      "types": "./src/run-progress-evaluation/index.ts",
      "import": "./dist/run-progress-evaluation/index.js"
    },
    "./current-turn-tool-exposure-evaluation": {
      "types": "./src/current-turn-tool-exposure-evaluation/index.ts",
      "import": "./dist/current-turn-tool-exposure-evaluation/index.js"
    },
    "./delegation-transfer-evaluation": {
      "types": "./src/delegation-transfer-evaluation/index.ts",
      "import": "./dist/delegation-transfer-evaluation/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:harness": "tsc -p tsconfig.harness.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:harness": "tsc -p tsconfig.harness.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:context-continuity": "vitest run src/context-continuity-evaluation/ContextContinuityEvaluation.test.ts src/context-continuity-evaluation/ContextContinuityAdverseConformance.test.ts src/context-continuity-evaluation/ContextContinuityPublicApi.test.ts",
    "test:verification-behavior": "vitest run src/verification-behavior/VerificationBehaviorConformance.test.ts src/verification-behavior/VerificationBehaviorEvaluation.test.ts",
    "test:run-progress": "vitest run src/run-progress-evaluation/RunProgressEvaluation.test.ts src/run-progress-evaluation/RunProgressEvaluationPublicApi.test.ts",
    "test:tool-exposure": "vitest run src/current-turn-tool-exposure-evaluation/CurrentTurnToolExposureEvaluation.test.ts src/current-turn-tool-exposure-evaluation/CurrentTurnToolExposureEvaluationPublicApi.test.ts",
    "test:delegation-transfer": "vitest run src/delegation-transfer-evaluation/DelegationTransferEvaluation.test.ts src/delegation-transfer-evaluation/DelegationTransferEvaluationPublicApi.test.ts",
    "test:agent-instructions": "vitest run src/evaluation-targets/helarc/HelarcAgentInstructionEvaluation.test.ts src/evaluation-targets/helarc/HelarcProductEffectivenessProtocol.test.ts src/evaluation-targets/helarc/HelarcProductEffectivenessCapture.test.ts src/evaluation-targets/helarc/HelarcEvaluationPublicApi.test.ts",
    "test:operational-evaluation": "vitest run src/evaluation-targets/helarc/operational-evaluation/HelarcOperationalEvaluation.test.ts src/evaluation-targets/helarc/operational-evaluation/HelarcOperationalConformanceExecution.test.ts src/evaluation-targets/helarc/HelarcEvaluationPublicApi.test.ts",
    "test:operational-conformance": "vitest run src/evaluation-targets/helarc/operational-evaluation/HelarcOperationalConformanceExecution.test.ts",
    "test:evaluation": "vitest run src/evaluation-targets/helarc/HelarcEvaluationRegression.test.ts src/evaluation-targets/helarc/operational-evaluation/HelarcOperationalEvaluation.test.ts src/evaluation-targets/helarc/operational-evaluation/HelarcOperationalConformanceExecution.test.ts src/context-continuity-evaluation/ContextContinuityEvaluation.test.ts src/context-continuity-evaluation/ContextContinuityAdverseConformance.test.ts src/verification-behavior/VerificationBehaviorEvaluation.test.ts src/run-progress-evaluation/RunProgressEvaluation.test.ts src/run-progress-evaluation/RunProgressEvaluationPublicApi.test.ts src/current-turn-tool-exposure-evaluation/CurrentTurnToolExposureEvaluation.test.ts src/current-turn-tool-exposure-evaluation/CurrentTurnToolExposureEvaluationPublicApi.test.ts src/delegation-transfer-evaluation/DelegationTransferEvaluation.test.ts src/delegation-transfer-evaluation/DelegationTransferEvaluationPublicApi.test.ts",
    "evaluation:baseline:candidate": "node scripts/emit-helarc-evaluation-baseline.mjs",
    "evaluation:product-effectiveness:compare": "node scripts/compare-helarc-product-effectiveness.mjs"
  },
  "agentAnything": {
    "architecture": {
      "kind": "tooling",
      "component": "test-support"
    }
  },
  "dependencies": {
    "@agent-anything/action-execution": "workspace:*",
    "@agent-anything/canonical-action": "workspace:*",
    "@agent-anything/agent-runtime": "workspace:*",
    "@agent-anything/agent-core": "workspace:*",
    "@agent-anything/context": "workspace:*",
    "@agent-anything/evaluation": "workspace:*",
    "@agent-anything/governance": "workspace:*",
    "@agent-anything/helarc": "workspace:*",
    "@agent-anything/helarc-code-agent": "workspace:*",
    "@agent-anything/helarc-local-environment": "workspace:*",
    "@agent-anything/host": "workspace:*",
    "@agent-anything/interaction": "workspace:*",
    "@agent-anything/model-interaction": "workspace:*",
    "@agent-anything/observability": "workspace:*",
    "@agent-anything/operation-catalog": "workspace:*",
    "@agent-anything/permission": "workspace:*",
    "@agent-anything/tools": "workspace:*",
    "@agent-anything/verification": "workspace:*",
    "@agent-anything/workspace": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1"
  },
  "license": "Apache-2.0",
  "private": true
}
